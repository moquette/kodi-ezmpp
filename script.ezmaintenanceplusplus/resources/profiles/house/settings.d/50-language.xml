<settings version="2">
    <!-- Settings > Player > Language. WRITE THE STORED VALUE, NOT THE SCREEN
         LABEL: the screen shows "Original language" and "Only forced" but Kodi
         stores "original" and "forced_only", and it silently discards any
         value it does not recognise - no error, no log line, the setting just
         reverts. The office box once played Japanese audio for six commits
         because a comment claimed the label form was correct. Values here were
         measured off the office reference box (2026-08-18) and re-verified as
         accepted by a live Settings.SetSettingValue on Kodi 22 (2026-08-30). -->
    <setting id="locale.audiolanguage">original</setting>
    <setting id="locale.subtitlelanguage">forced_only</setting>
</settings>
